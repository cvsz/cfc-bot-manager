# Copy to .env for local development and customize safely.
# Never commit real credentials or production secrets.

APP_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# Go backend API (local-only default)
HTTP_ADDR=127.0.0.1:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Optional room-style persistence. Configure both values to enable it.
# Generate a random token with: openssl rand -hex 32
# DATABASE_URL=postgres://cfc_bot_manager:REPLACE_ME@127.0.0.1:5432/cfc_bot_manager?sslmode=disable
# ROOM_STYLE_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
